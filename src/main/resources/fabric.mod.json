{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mc_version}-${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${mod_group}.${mod_id}.${mod_main_class}"
    ],
    "client": [
      "${mod_group}.${mod_id}.client.${mod_main_class}Client"
    ],
    "fabric-datagen": [
      "${mod_group}.${mod_id}.${mod_main_class}Datagen"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${mc_version}"
  },
  "suggests": {
    "create": ">=${create_version}",
    "tconstruct": ">=${hephaestus_version}",
    "ad_astra": ">=${ad_astra_version}"
  }
}
